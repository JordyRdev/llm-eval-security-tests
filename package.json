{
  "name": "llm-eval-security-tests",
  "version": "0.0.0",
  "private": true,
  "description": "LLM evaluation and OWASP LLM Top 10 security tests for a text-to-SQL 'ask your data' chat, run as CI/CD quality gates.",
  "license": "MIT",
  "author": "JordyRdev",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:data": "tsx scripts/verify-dataset.ts",
    "build:db": "tsx scripts/build-db.ts",
    "start": "tsx --env-file-if-exists=.env src/app/server.ts",
    "dev": "tsx watch --env-file-if-exists=.env src/app/server.ts",
    "smoke": "tsx --env-file-if-exists=.env scripts/smoke.ts",
    "check": "npm run lint && npm run typecheck && npm run verify:data && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "better-sqlite3": "^13.0.3",
    "esbuild": "^0.28.2",
    "hono": "^4.13.14",
    "node-sql-parser": "^5.4.0",
    "openai": "^7.43.0",
    "zod": "^4.6.7"
  }
}
