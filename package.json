{
  "name": "llm-eval-security-tests",
  "version": "0.0.0",
  "private": true,
  "description": "LLM evaluation and OWASP LLM Top 10 security tests for a text-to-SQL 'ask your data' chat, run as CI/CD quality gates.",
  "license": "MIT",
  "author": "JordyRdev",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:data": "tsx scripts/verify-dataset.ts",
    "check": "npm run lint && npm run typecheck && npm run verify:data && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
