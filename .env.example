# Copy to .env for local runs (npm start, npm run smoke, npm run eval). Never commit real keys.

# LLM provider for the app: groq | ollama | replay.
# Without it, groq is used when GROQ_API_KEY is set and ollama otherwise.
LLM_PROVIDER=ollama

# Groq free plan key (https://console.groq.com/keys). Leave empty to use Ollama.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Local Ollama endpoint (OpenAI-compatible) and model
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3:4b

# Recorded model replies for LLM_PROVIDER=replay
REPLAY_FILE=evals/recordings/app.json

# Judge for the faithfulness score (llm-rubric): groq | ollama | replay.
# Defaults: qwen/qwen3.8-27b on Groq, llama3.2:3b on Ollama (another family than the app model).
JUDGE_PROVIDER=ollama
JUDGE_MODEL=
JUDGE_REPLAY_FILE=evals/recordings/judge.json

# Golden-set eval: full (40) | pr (12) | fork (8). EVAL_JUDGE=0 skips the judge;
# EVAL_RECORD=1 saves live replies to REPLAY_FILE and JUDGE_REPLAY_FILE.
EVAL_SUBSET=full
EVAL_JUDGE=1
EVAL_RECORD=0

# Security suite (npm run security): full (every case, hardened and vulnerable) | smoke (10
# cases). It always runs both modes and replays from evals/recordings/security-app.json.
SECURITY_SUBSET=full

# hardened (default) | vulnerable (deliberately weak baseline for the security suite)
APP_MODE=hardened

# Where npm run build:db writes the role databases
DB_DIR=data/build

# HTTP server
HOST=127.0.0.1
PORT=3000
