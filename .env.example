# Copy to .env for local runs. Never commit real keys.

# LLM provider for the app: groq | ollama | replay
LLM_PROVIDER=ollama

# Groq free plan key (https://console.groq.com/keys). Leave empty to use Ollama.
GROQ_API_KEY=

# Local Ollama endpoint (OpenAI-compatible)
OLLAMA_BASE_URL=http://localhost:11434/v1

# hardened (default) | vulnerable (deliberately weak baseline for the security suite)
APP_MODE=hardened
